{
  "rewrites": [
    { "source": "/", "destination": "/index.html" },
    { "source": "/portal", "destination": "/portal.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    }
  ],
  "crons": [
    { "path": "/api/recurring/run-due", "schedule": "30 6 * * *" }
  ]
}
